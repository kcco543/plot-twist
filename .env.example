# Copy this file to .env.local (same folder) and fill in the keys you have.
# These are read only on the server (src/lib/ai/server/). They never reach the browser.
# Restart `npm run dev` after changing this file.

# Claude: personality analysis and AI-written dialogue/events.
# Get a key at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=

# OpenAI Images: "Generate Pixel Character" in the Sprite Studio, and "Generate Map" + "Edit Selected Area" in the World Builder.
# Get a key at https://platform.openai.com/ → API keys.
OPENAI_API_KEY=

# Optional overrides
# Claude model per feature (defaults shown in docs/AI_COSTS.md):
#   ANTHROPIC_MODEL        personality analysis + refinement   (claude-opus-5-5)
#   ANTHROPIC_TALK_MODEL   conversations, photo/gift reactions (claude-sonnet-5-5)
#   ANTHROPIC_STORY_MODEL  story-beat wording                  (claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_PROVIDER=openai
# AI_DISABLED=1          # turn every AI feature off without removing keys

# AI conversations (walk & talk). All optional.
# ANTHROPIC_TALK_MODEL=claude-sonnet-5-5
# AI_TALK_PER_MINUTE=12                  # replies per visitor per minute
# AI_TALK_PER_DAY=300                    # replies per visitor per day
# AI_TALK_DAILY_LIMIT=1500               # replies for the whole server per day
# AI_TALK_MOCK=1                         # development only: canned TEST replies without a key (never in production)

# AI usage mode and cost limits (also adjustable on http://localhost:3000/dev/usage). All optional.
# AI_MODE=balanced                 # offline | balanced | full
# AI_MAX_REQUESTS_PER_MINUTE=20
# AI_MAX_CONCURRENT=3
# AI_MAX_OUTPUT_TOKENS=12000
# AI_SESSION_BUDGET_USD=2          # app-side estimate, not a billing cap
# AI_USAGE_LOG=1                   # print one line of numbers per request in the server log

# Cloud saves (sign in and continue your worlds on another device). Optional:
# without these the game saves on this device only, and Export/Import still work.
# Supabase project → Project Settings → API: the Project URL and the publishable (or anon) key.
# Both are safe to expose to the browser; row-level security keeps each player's saves private.
# NEXT_PUBLIC_SUPABASE_URL=…
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=…

# Public beta (see docs/PUBLIC_BETA.md). In production the AI routes need a tester code;
# leave these unset locally to keep localhost:3000 working as before.
# BETA_ACCESS_CODES=code-one,code-two   # 6+ characters each; testers enter one on the title screen
# BETA_COOKIE_SECRET=…                  # long random string that signs tester passes
# BETA_TEXT_PER_DAY=60                  # text units per tester per day
# BETA_AUTO_PER_DAY=15                  # autonomous conversations per tester per day
# BETA_IMAGES_PER_DAY=0                 # image generations per tester per day (0 = off)
# BETA_TEXT_DAILY_LIMIT=600             # whole site, per day
# BETA_AUTO_DAILY_LIMIT=200
# BETA_IMAGES_DAILY_LIMIT=10
# Server-only Supabase secret key: lets every server instance share the daily counts. Never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=…
