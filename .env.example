# Copy this file to .env.local (same folder) and fill in the keys you have.
# These are read only on the server (src/lib/ai/server/). They never reach the browser.
# Restart `npm run dev` after changing this file.

# Claude: personality analysis and AI-written dialogue/events.
# Get a key at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=

# OpenAI Images: "Generate Pixel Character" in the Sprite Studio.
# Get a key at https://platform.openai.com/ → API keys.
OPENAI_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_PROVIDER=openai
# AI_DISABLED=1          # turn every AI feature off without removing keys
